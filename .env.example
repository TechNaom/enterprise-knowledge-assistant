# Enterprise Knowledge Assistant — environment configuration
# Copy this file to ".env" and edit as needed. NEVER commit your real .env.

# ---------------------------------------------------------------------------
# Provider: "ollama" (local, open-source, default) or "gemini" (hosted).
# ---------------------------------------------------------------------------
EKA_PROVIDER=ollama

# --- Ollama (local) --------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Gemini (hosted; used for the public live deployment) ------------------
# Get a free key at https://aistudio.google.com/apikey
# To use Gemini: set EKA_PROVIDER=gemini and fill GOOGLE_API_KEY below,
# then re-run: python ingest.py   (so document + query embeddings match).
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---------------------------------------------------------------------------
# Retrieval / chunking (sensible defaults; override only if you want to tune)
# ---------------------------------------------------------------------------
EKA_CHUNK_SIZE=900
EKA_CHUNK_OVERLAP=150
EKA_TOP_K=4
EKA_MULTI_QUERY=true
EKA_RERANK=true
